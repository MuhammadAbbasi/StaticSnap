{
  "name": "wp-to-astro",
  "version": "0.1.0",
  "description": "StaticSnap — Instant Web-to-Static Replatformer. Clone any website into a self-contained static .zip via a real-time dashboard (Express + SSE + archiver). Includes the wp-to-astro CLI.",
  "type": "module",
  "bin": {
    "wp-to-astro": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "dev:server": "tsx watch src/server/server.ts",
    "serve": "node ./dist/server/server.js",
    "start:server": "node ./dist/server/server.js",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/cli.js",
    "test:e2e": "node ./tests/e2e.mjs",
    "test:unit": "node ./tests/srcset.test.mjs && node ./tests/terminal.test.mjs && node ./tests/ssrf.test.mjs && node ./tests/limits.test.mjs && node ./tests/screenshots.test.mjs && node ./tests/secrets.test.mjs && node ./tests/deployment.test.mjs",
    "test": "npm run test:unit && npm run test:fidelity && npm run test:e2e",
    "test:fidelity": "node ./tests/offline-fidelity.test.mjs",
    "test:screenshots": "node ./tests/screenshots.test.mjs",
    "docker:build": "docker build -t staticsnap .",
    "docker:up": "docker compose up --build",
    "docker:up:prod": "docker compose --profile prod up -d --build"
  },
  "keywords": [
    "wordpress",
    "astro",
    "mdx",
    "migration",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@wordpress/block-serialization-default-parser": "^5.54.0",
    "archiver": "^8.0.0",
    "cheerio": "^1.2.0",
    "commander": "^14.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "fs-extra": "^11.4.0",
    "gray-matter": "^4.0.3",
    "p-limit": "^7.3.2",
    "picocolors": "^1.1.1",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.4.1",
    "@types/turndown": "^5.0.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
