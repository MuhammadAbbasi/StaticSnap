# StaticSnap environment — copy to `.env` and adjust.
#   cp .env.example .env
# Compose reads this file automatically (see docker-compose.yml).
#
# ── Deployment identity ──────────────────────────────────────────────
# Local Docker run: leave DOMAIN/PUBLIC_URL empty, DEPLOYMENT=selfhost.
# Hosted service:  DOMAIN=staticscan.muhammadabbasi.com
#                  STATICSNAP_PUBLIC_URL=https://staticscan.muhammadabbasi.com
#                  STATICSNAP_DEPLOYMENT=cloud
#                  STATICSNAP_BEHIND_PROXY=1   (Caddy is in front)

DOMAIN=staticscan.muhammadabbasi.com
APP_PORT=3000
STATICSNAP_DEPLOYMENT=selfhost
STATICSNAP_PUBLIC_URL=
STATICSNAP_BEHIND_PROXY=0

# ── Access control ───────────────────────────────────────────────────
# Empty = open (fine for localhost). For the public hosted service, set a
# token for admin use; end users stay anonymous behind rate limits.
STATICSNAP_ACCESS_TOKEN=

# ── Abuse + disk guards ──────────────────────────────────────────────
STATICSNAP_MAX_CONCURRENT_JOBS=3
STATICSNAP_RATE_MAX=5
STATICSNAP_RATE_WINDOW_MS=60000
STATICSNAP_MAX_JOB_BYTES=2147483648
STATICSNAP_MAX_TOTAL_BYTES=10737418240

# ── Subscribed (Pro) tier ────────────────────────────────────────────
# Self-hosted: set either flag to unlock the secret-exposure scan for everyone
# on this instance. Hosted service: these stay OFF so the scan remains a paid
# Pro feature (requested scans are refused with 402 + upgrade notice until
# per-user billing lands — see docs/future-roadmap-and-monetization.md).
STATICSNAP_PRO_ENABLED=
STATICSNAP_SECRET_SCAN_ENABLED=

# ── Screenshots (Playwright Chromium ships in the image) ─────────────
STATICSNAP_SCREENSHOT_TIMEOUT_MS=30000
STATICSNAP_SCREENSHOT_CONCURRENCY=2
STATICSNAP_MAX_SCREENSHOTS=360

# ── Dev only ─────────────────────────────────────────────────────────
# NEVER enable on the public hosted service.
STATICSNAP_ALLOW_PRIVATE=
